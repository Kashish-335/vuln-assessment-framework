# ==============================================================================
# Academic Web Application Vulnerability Assessment Framework
# Environment Configuration Template (.env.example)
#
# QUICK SETUP:
# 1. Copy this file to create your local .env:
#    cp .env.example .env
# 2. Generate a secure random SECRET_KEY:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
# 3. Set a strong ZAP_API_KEY matching your OWASP ZAP daemon or docker-compose
# ==============================================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=False
# Cryptographically secure random key for session signing
SECRET_KEY=your-generated-secret-key-here

# OWASP ZAP API Daemon (Docker or Local)
ZAP_URL=http://localhost:8090
# API key configured in OWASP ZAP daemon (passed to docker-compose as ${ZAP_API_KEY})
ZAP_API_KEY=your-secure-zap-api-key-here

# Target & Proxy Settings
UPSTREAM_TARGET_URL=http://localhost:3000
WAF_PORT=8080
DASHBOARD_PORT=5000

# Rate Limiting (Requests Per Minute per client IP)
WAF_RATE_LIMIT_RPM=60
